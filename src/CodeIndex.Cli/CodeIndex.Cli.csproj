<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeIndex.Core\CodeIndex.Core.csproj" />
    <ProjectReference Include="..\CodeIndex.Roslyn\CodeIndex.Roslyn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" Version="2.0.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>code-index</ToolCommandName>
    <PackageId>CodeIndex.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>CodeIndex</Authors>
    <Description>Index-first CLI for compact code navigation by AI agents.</Description>
  </PropertyGroup>

</Project>
